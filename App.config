<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        autoReload="true"
        internalLogLevel="Info"
        internalLogFile="internal-nlog.txt">
    <targets>
      <target name="logfile" xsi:type="File"
              fileName="${basedir}/logs/temperature.log"
              layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}"
              archiveEvery="Day"
              maxArchiveFiles="7"
              archiveFileName="${basedir}/logs/archive.{#}.log" />
      <target name="logconsole" xsi:type="Console"
              layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" />
    </targets>
    <rules>
      <logger name="*" minlevel="Debug" writeTo="logfile,logconsole" />
    </rules>
  </nlog>
</configuration>
